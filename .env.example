# MTK Finance — copy to .env at repo root (used by frontend + backend)

# local | staging | production
ENVIRONMENT=local

# Copy exact URI from Supabase → Settings → Database → Connect → Session pooler
# Example (replace password; URL-encode special chars in password):
# DATABASE_URL=postgresql+psycopg://postgres.gthbrotivsonqvfqebeb:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Or direct: postgresql+psycopg://postgres:YOUR_PASSWORD@db.gthbrotivsonqvfqebeb.supabase.co:5432/postgres
DATABASE_URL=

SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

SITE_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Browser uses same-origin /api/v1 (Next rewrites). Port only matters for SSR.
NEXT_PUBLIC_API_URL=http://localhost:3000
# Local dev only — Next proxies to FastAPI. Do not set on Vercel.
API_URL=http://127.0.0.1:8000

AUTO_FINALIZE_DAYS=7

# Google Gemini — required for Finance Assistant chat
# https://aistudio.google.com/apikey
# Rate limits: https://ai.google.dev/gemini-api/docs/rate-limits
GEMINI_API_KEY=
# Fallback key (best from a different Google Cloud project — limits are per project)
GEMINI_API_KEY2=
# Primary model (matches AI Studio curl: gemini-flash-latest)
GEMINI_MODEL=gemini-flash-latest
# Comma-separated fallbacks if primary hits per-model quota
GEMINI_MODEL_FALLBACKS=gemini-2.0-flash,gemini-2.0-flash-lite
# Global app limits (all users share one Gemini project quota)
GEMINI_RPM_GLOBAL=12
GEMINI_RPD_GLOBAL=200
# Per-user fair-use limits
GEMINI_RPM_PER_USER=8
GEMINI_RPD_PER_USER=80
GEMINI_MIN_INTERVAL_SECONDS=6
GEMINI_MAX_HISTORY_MESSAGES=6
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_SEC=2
# Cooldown before reusing a key after failure (seconds)
GEMINI_KEY_QUOTA_COOLDOWN_SECONDS=3600
GEMINI_KEY_RATE_LIMIT_COOLDOWN_SECONDS=60
GEMINI_KEY_AUTH_COOLDOWN_SECONDS=86400
GEMINI_MODEL_QUOTA_COOLDOWN_SECONDS=300

# Gmail SMTP (use App Password — https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=your.email@gmail.com
# All app emails are delivered here (password reset, notifications, etc.)
MAIL_TO=your.inbox@gmail.com

# Secret for Next.js → FastAPI password-reset (generate random string)
EMAIL_INTERNAL_SECRET=
