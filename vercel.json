{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "build": {
    "env": {
      "PYTHONPATH": "server"
    }
  },
  "functions": {
    "api/**/*.py": {
      "maxDuration": 30,
      "excludeFiles": "{tests/**,__pycache__/**,.venv/**,**/*.pyc,alembic/**}"
    }
  },
  "crons": [
    {
      "path": "/api/v1/cron/daily-report",
      "schedule": "29 18 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/api/health",
      "destination": "/api/index"
    }
  ]
}
