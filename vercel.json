{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install && pip install -r requirements.txt",
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "functions": {
    "server/app/api/index.py": {
      "runtime": "python3.12",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "/server/app/api/index.py"
    },
    {
      "source": "/api/health",
      "destination": "/server/app/api/index.py"
    },
    {
      "source": "/api/docs",
      "destination": "/server/app/api/index.py"
    },
    {
      "source": "/api/openapi.json",
      "destination": "/server/app/api/index.py"
    }
  ]
}
